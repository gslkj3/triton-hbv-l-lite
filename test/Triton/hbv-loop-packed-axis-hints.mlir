// RUN: triton-opt %s -triton-hbv-loop-facts -triton-hbv-loop-decision -triton-loop-unroll -triton-hbv-loop-materialize -triton-hbv-validate-loop-plan | FileCheck %s --implicit-check-not=tt.contiguity --implicit-check-not=tt.divisibility --implicit-check-not=tt.constancy
//
// Rank-one axis hints cannot be copied onto newly packed higher-rank operations.
// CHECK-LABEL: tt.func public @rank_hint_packing
// CHECK: arith.mulf
// CHECK-SAME: tensor<{{[0-9]+x([0-9]+x)+}}f32>
// CHECK: tt.store
module attributes {tt.hbv.plan_bundle = "{\22bundle_id\22:\22bundle:integer-carry\22,\22contract\22:{\22candidate_parameters\22:{\22adapter_version\22:8,\22bridge_factor\22:1,\22combiner\22:\22operator_preserving\22,\22composition_schema\22:\22hbv.loop.bridge-route-composition.v2\22,\22exact_split_elision\22:false,\22factor_admission_ref\22:\22l.route-factor-admission.f1eb4d2a0fe0a72b6a500446\22,\22invariant_hoisting\22:false,\22iteration_axis\22:0,\22kind\22:\22l.ttir.full_unroll_logical_group.v1\22,\22mask_tail_policy\22:\22native_unroll_main_ordered_remainder\22,\22packing_policy\22:\22registered_exact_operation_capability\22,\22route_factor\22:4,\22route_factor_kind\22:\22logical_vector_grouping_width\22,\22route_subject_exact_trip_count\22:4,\22route_subject_ref\22:\22l.route-subject.6c7aa62492ce5a6041c00b2c\22,\22runtime_main_tail_certificate_ref\22:\22\22,\22subject_policy\22:\22unique_eligible_existing_scf_for\22,\22subject_ref\22:\22subject:integer-carry\22,\22tensor_lane_fusion\22:true},\22decision_ref\22:\22decision:integer-carry\22,\22dynamic_guard_assumptions\22:[{\22guard_id\22:\22l.bundle.schema\22,\22required\22:true,\22responsible_stage\22:\22python_preflight+ttir_focal\22,\22verifier_or_legality_binding\22:\22PlanContractV1+TritonHBVLoopDecisionPass\22},{\22guard_id\22:\22l.target.binding\22,\22required\22:true,\22responsible_stage\22:\22python_preflight\22,\22verifier_or_legality_binding\22:\22CUDAOptions.sm89.loop_bridge_composition_adapter.v8\22},{\22guard_id\22:\22l.subject.unique_fresh\22,\22required\22:true,\22responsible_stage\22:\22pre_loop_unroll\22,\22verifier_or_legality_binding\22:\22TritonHBVLoopDecisionPass\22},{\22guard_id\22:\22l.subject.structure\22,\22required\22:true,\22responsible_stage\22:\22pre_loop_unroll\22,\22verifier_or_legality_binding\22:\22LegalLoopSubjectView.adapter.v1\22},{\22guard_id\22:\22l.effects_dependencies\22,\22required\22:true,\22responsible_stage\22:\22bridge+pre_loop_unroll\22,\22verifier_or_legality_bindi